# HeavenlyNova Environment Variables
# Copy this file to .env.local and fill in your values (never commit .env.local)

# ─── Shopify Storefront API ───────────────────────────────────────────────────
# Your Shopify store domain (without https://)
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Shopify Storefront Access Token (public token — safe in client-side code)
VITE_SHOPIFY_STOREFRONT_TOKEN=

# ─── Feature Flags ────────────────────────────────────────────────────────────
# true  = use mock data from src/data/drops.ts (no Shopify account needed)
# false = use live Shopify Storefront API (requires domain + token above)
VITE_USE_MOCK_DATA=true

# ─── Analytics (when needed) ─────────────────────────────────────────────────
# VITE_GA_TRACKING_ID=
